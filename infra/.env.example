# Секреты Мигома на сервере. Скопируй в infra/.env и заполни; infra/.env в репозиторий не входит.
# Случайное значение: openssl rand -hex 32

POSTGRES_PASSWORD=
MINIO_PASSWORD=

# Секреты клиентов Мигома в Keycloak Goden: те же значения, что MIGOM_BACKEND_SECRET и
# MIGOM_INTEGRATION_SECRET в infra/.env Goden (их выставляет задача keycloak-config Goden)
MIGOM_BACKEND_SECRET=
MIGOM_INTEGRATION_SECRET=

# Ключ JavaScript API Яндекс Карт для кабинета владельца; без него карты в кабинете не грузятся
YANDEX_MAPS_API_KEY=

# Домены по умолчанию: migom.site (API, owner. и admin. - кабинеты) и goden.pro (Keycloak и API Goden)
# MIGOM_DOMAIN=migom.site
# GODEN_DOMAIN=goden.pro
