# Приложение
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8001

# База данных (та же что у business_service)
# DB_HOST=localhost
DB_HOST=postgres
DB_PORT=5432
DB_NAME=migom
DB_USER=postgres
DB_PASSWORD=postgres

# Redis
# REDIS_HOST=localhost
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Keycloak Goden (realm goden): проверка токенов, см. business_service/.env.example
KEYCLOAK_REALM_URL=http://host.docker.internal:8180/realms/goden
KEYCLOAK_ISSUER=http://localhost:8180/realms/goden
KEYCLOAK_AUDIENCE=migom-api

# API Goden: из контейнера хост виден как host.docker.internal; сервисная учётная запись Мигома
GODEN_API_URL=http://host.docker.internal:8080/api/v1
GODEN_CLIENT_ID=migom-integration
GODEN_CLIENT_SECRET=migom-integration-dev-secret
