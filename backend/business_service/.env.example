# Приложение
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# База данных
# DB_HOST=localhost
DB_HOST=postgres
DB_PORT=5432
DB_NAME=migom
DB_USER=postgres
DB_PASSWORD=postgres

# Redis
# REDIS_HOST=localhost
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Keycloak Goden (realm goden). KEYCLOAK_REALM_URL - адрес, по которому сервис ходит в realm
# (из контейнера Keycloak хоста виден как host.docker.internal), KEYCLOAK_ISSUER - издатель в токенах.
# Локально - Keycloak окружения Goden (docker compose -f infra/compose.yaml up в репозитории Goden).
KEYCLOAK_REALM_URL=http://host.docker.internal:8180/realms/goden
KEYCLOAK_ISSUER=http://localhost:8180/realms/goden
KEYCLOAK_AUDIENCE=migom-api
KEYCLOAK_CLIENT_ID=migom-backend
KEYCLOAK_CLIENT_SECRET=migom-backend-dev-secret

# MinIO
# MINIO_ENDPOINT=localhost:9000
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=migom-media
MINIO_USE_SSL=false
# Публичный хост MinIO для генерации URL (виден браузеру)
MINIO_PUBLIC_ENDPOINT=localhost:7000
