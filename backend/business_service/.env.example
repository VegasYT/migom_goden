# Приложение
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# База данных
# DB_HOST=localhost
DB_HOST=postgres
DB_PORT=5432
DB_NAME=migom
DB_USER=postgres
DB_PASSWORD=postgres

# Redis
# REDIS_HOST=localhost
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=30

# MinIO
# MINIO_ENDPOINT=localhost:9000
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=migom-media
MINIO_USE_SSL=false
# Публичный хост MinIO для генерации URL (виден браузеру)
MINIO_PUBLIC_ENDPOINT=localhost:7000
