# Раздача собранного кабинета внутри контейнера. HTTPS и домены - забота внешнего прокси
# (Caddy сервера Goden), поэтому здесь обычный HTTP.
{
	admin off
	auto_https off
}

:80 {
	root * /srv
	encode zstd gzip
	# адреса страниц обрабатывает роутер в браузере: неизвестный путь отдаёт index.html
	try_files {path} /index.html
	file_server

	# имена файлов сборки содержат хеш содержимого и не меняются
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
}
